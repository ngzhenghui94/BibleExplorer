# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Server ----
PORT=3000
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# OAuth client type: "Web application"
# Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---- Groq (AI features) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# ---- Neon Postgres ----
# Copy the pooled connection string from your Neon project dashboard.
# Should look like: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
